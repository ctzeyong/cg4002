# python
__pycache__/

# testing
*.pytest_cache/
logs/

# virtual environments
.venv/
venv/
env/

# video — rendered output, raw footage, and the assembled cut. All regenerable from
# video/src + video/order.txt, and all far too large for a repo (one 1080p capture of a
# two-node run outweighs everything tracked here). The scene sources, theme, cut list,
# script and build script ARE tracked; nothing under these four is.
video/media/
video/captures/
video/out/
video/scratch*.txt

# ide
.vscode/

# environment / secrets
.env

# mTLS key material. The CA key, the broker key and every client key are generated
# locally and must never reach the remote. Ignored BEFORE the
# directory exists, so the first `openssl` run cannot be committed by accident.
certs/
*.key
*.pem
*.p12
*.pfx

# The broker's mTLS listener block. Generated by laptop/make_certs.ps1, and it
# holds absolute paths -- which on Windows contain the username. Mosquitto does
# not expand environment variables, so the path cannot be indirected through a
# secrets file; the file holding it just never gets committed. The directory
# placeholder IS tracked: mosquitto aborts startup unless include_dir holds at
# least one *.conf, so a fresh clone would not start without it. A .gitkeep does
# not do -- only *.conf is scanned.
laptop/local/*
!laptop/local/00-placeholder.conf

# claude code local config + auto memory (machine-local, never committed)
.claude/

# unity — generated, machine-local, and large. never commit these.
# applies to phone/ and unity_tunnel_spike/ alike.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.vsconfig
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.apk
*.aab
*.unitypackage
sysinfo.txt
crashlytics-build.properties
*.utmp/