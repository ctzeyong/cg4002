# Copy to .env (gitignored) and fill in. Never commit .env.
#
# Used for laptop/tunnel.py. Any value can also be overridden on the command
# line, e.g. `python tunnel.py --board-host makerslab-fpga-NN.ddns.comp.nus.edu.sg`.
#
# JUMP_PASSWORD is OPTIONAL and empty by default. Left empty, tunnel.py prompts
# once and keeps it in memory only. Filled in, it lets a logon task start the
# relay with nobody at the keyboard -- at the cost of your primary NUS credential
# sitting in plaintext in .env, so leave it empty unless you need that.

# SoC username for the jump host
JUMP_USER=your_nusnet_id

# Optional. Empty = prompt every run. See the warning at the top of this file.
JUMP_PASSWORD=

# Student jump host
JUMP_HOST=stujump.comp.nus.edu.sg

# Ultra96 login and the board number assigned (replace XX)
BOARD_USER=xilinx
BOARD_HOST=makerslab-fpga-NN.ddns.comp.nus.edu.sg

# Must match --port on tcp_server.py / tcp_client.py.
TUNNEL_PORT=8888

# Optional. Defaults to comms/logs/tunnel.log.
# TUNNEL_LOG=C:\Users\you\CG4002\comms\logs\tunnel.log

# Configuration A on a phone hotspot (run_pipeline_a_hotspot.ps1, run_board_a_hotspot.ps1)
# reaches the board over Tailscale instead. Its 100.x address, from `tailscale status`.
# See docs/subsystem/comms/README.md, section 5.
TAILSCALE_BOARD_HOST=100.x.y.z
